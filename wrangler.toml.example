name = "siterise"
main = ".open-next/worker.js"
compatibility_date = "2025-03-01"
compatibility_flags = ["nodejs_compat", "global_fetch_strictly_public"]

[assets]
binding = "ASSETS"
directory = ".open-next/assets"

send_email = [{ name = "EMAIL" }]

# Enable Hyperdrive only when using PostgreSQL through Cloudflare.
# [[hyperdrive]]
# binding = "HYPERDRIVE"
# id = ""
# localConnectionString = ""

[observability]
enabled = true

[[services]]
binding = "WORKER_SELF_REFERENCE"
service = "siterise"

[vars]
# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "SiteRise"
NEXT_PUBLIC_APP_DESCRIPTION = "Website opportunity intelligence for finding fast-growing domains and competitor movement."
NEXT_PUBLIC_APP_LOGO = "/logo.png"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
# SiteRise uses Supabase Postgres as the primary business database.
# Do not use process singleton in Cloudflare Workers.
# Set DATABASE_URL as a Wrangler secret. For Workers, use Supabase pooler or Hyperdrive.
DATABASE_PROVIDER = "postgresql"
DB_SCHEMA_FILE = "./src/config/db/schema.ts"
DB_SCHEMA = "siterise"
DB_MIGRATIONS_SCHEMA = "drizzle"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_postgres"
DB_MIGRATIONS_TABLE = "__drizzle_migrations_siterise"
DB_SINGLETON_ENABLED = "false"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
EMAIL_VERIFICATION_ENABLED = "true"

# email: Cloudflare Email Service Workers API
CLOUDFLARE_EMAIL_ENABLED = "true"
CLOUDFLARE_EMAIL_BINDING = "EMAIL"
CLOUDFLARE_EMAIL_SENDER = "SiteRise <no-reply@email.siterisehq.com>"

# traffic data provider
QUERY_DOMAINS_API_KEY = ""
QUERY_DOMAINS_TRAFFIC_BASE_URL = "https://api.query.domains/api/v1/traffic"
QUERY_DOMAINS_CACHE_TTL_DAYS = "30"
RDAP_DNS_BOOTSTRAP_URL = "https://data.iana.org/rdap/dns.json"
RDAP_LOOKUP_TIMEOUT_MS = "8000"
WHOIS_CACHE_TTL_DAYS = "7"
PRODUCT_HUNT_API_TOKEN = ""
PRODUCTHUNT_CLIENT_ID = ""
PRODUCTHUNT_CLIENT_SECRET = ""
PRODUCT_HUNT_DISCOVERY_ENABLED = "true"
DISCOVERY_DNS_TIMEOUT_MS = "3000"
DISCOVERY_HTTP_TIMEOUT_MS = "6000"
DISCOVERY_MAX_TRAFFIC_LOOKUPS = "100"
DISCOVERY_MIN_VISITS = "1"
DISCOVERY_MIN_DR = "0"
AHREFS_DR_BASE_URL = "https://api.ahrefs.com/v3/public/domain-rating-free"
CERTSTREAM_URL = "wss://certstream.calidog.io"
