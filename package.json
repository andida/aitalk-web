  "scripts": {
    "dev": "next dev --turbopack",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build --webpack",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint .",
    "test:aitalk:ui": "node --import tsx --test src/features/aitalk/ui/free-talk-topic-selector.test.tsx",
    "test:payment-approval": "node --import tsx --test src/extensions/payment/paypal-approval.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "tsx scripts/with-env.ts npx drizzle-kit generate --config=src/core/db/config.ts",
    "db:migrate": "tsx scripts/with-env.ts npx drizzle-kit migrate --config=src/core/db/config.ts",
    "db:push": "tsx scripts/with-env.ts npx drizzle-kit push --config=src/core/db/config.ts",
    "db:studio": "tsx scripts/with-env.ts npx drizzle-kit studio --config=src/core/db/config.ts",
    "auth:generate": "tsx scripts/with-env.ts npx @better-auth/cli generate --config=src/core/auth/index.ts",
    "rbac:init": "tsx scripts/with-env.ts npx tsx scripts/init-rbac.ts",
    "rbac:assign": "tsx scripts/with-env.ts npx tsx scripts/assign-role.ts",
    "siterise:import-seeds": "tsx scripts/with-env.ts npx tsx scripts/siterise-import-seeds.ts",
    "siterise:import-semrush-seeds": "tsx scripts/with-env.ts npx tsx scripts/siterise-import-semrush-seeds.ts",
    "siterise:import-traffic-csv": "tsx scripts/with-env.ts npx tsx scripts/siterise-import-traffic-csv.ts",
    "siterise:discover-new-sites": "tsx scripts/with-env.ts npx tsx scripts/siterise-discover-new-sites.ts",
    "siterise:monitor-certstream": "tsx scripts/with-env.ts npx tsx scripts/siterise-monitor-certstream.ts",
    "siterise:refresh-whois": "tsx scripts/with-env.ts npx tsx scripts/siterise-refresh-whois.ts",
    "siterise:refresh-traffic": "tsx scripts/with-env.ts npx tsx scripts/siterise-refresh-traffic.ts",
    "siterise:build-leaderboards": "tsx scripts/with-env.ts npx tsx scripts/siterise-build-leaderboards.ts",
    "postinstall": "fumadocs-mdx",
    "cf:check": "node scripts/check-cloudflare-readiness.mjs",
    "cf:alpha:preview": "node scripts/deploy-cloudflare-alpha.mjs --preview",
    "cf:alpha:deploy": "node scripts/deploy-cloudflare-alpha.mjs --deploy",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv src/shared/types/cloudflare.d.ts",
    "test:aitalk": "node --import tsx --test src/features/aitalk/lib/*.test.ts src/shared/lib/cookie.test.ts src/shared/lib/media-task-result.test.ts src/shared/lib/carousel-navigation.test.ts src/shared/lib/chat-input.test.ts src/shared/lib/ai-task-display.test.ts src/shared/lib/error-message.test.ts src/shared/lib/payment-metadata.test.ts src/extensions/payment/creem-webhook.test.ts src/shared/lib/post-frontmatter.test.ts src/shared/lib/affiliate-referral.test.ts src/core/auth/user-create-hook.test.ts src/extensions/ai/validation.test.ts src/core/rbac/with-access-check.test.ts src/extensions/storage/upload-bytes.test.ts src/core/theme/bootstrap.test.ts src/features/aitalk/ui/free-talk-topic-selector.test.tsx src/mdx-components.test.tsx src/shared/blocks/table/json-preview.test.tsx src/shared/blocks/table/metadata.test.tsx src/shared/blocks/common/copyright.test.tsx src/shared/blocks/common/error-boundary.test.ts src/shared/hooks/use-hydrated.test.tsx src/shared/components/ui/sidebar-skeleton.test.tsx src/shared/components/ui/carousel.test.tsx src/shared/components/magicui/particles.test.tsx src/core/theme/showcases.test.tsx"
  },
